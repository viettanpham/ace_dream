# STARFRONT Environment Variables Configuration Template
# Copy this file to .env.local for local development overrides

# CDN & Asset Resolution
NEXT_PUBLIC_ASSET_STORAGE_MODE=cdn
NEXT_PUBLIC_ASSET_CDN_URL=https://cdn.jsdelivr.net/gh/viettanpham/starfront-assets@v3.0-assets-r3/starfront-world-assets
NEXT_PUBLIC_R2_ASSET_CDN_URL=

# Admin Authentication & Sessions
ADMIN_SESSION_SECRET=
STARFRONT_PREVIEW_SECRET_KEY=
STARFRONT_AUTH_FILE_PATH=
STARFRONT_SESSION_KEY_PATH=
STARFRONT_ADMIN_PRIMARY_PASSWORD=
STARFRONT_ADMIN_BACKUP_PASSWORD=
STARFRONT_ADMIN_THIRD_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Dev & Preview Mode Flags
STARFRONT_DEV_ADMIN_PREVIEW=false
NEXT_PUBLIC_STARFRONT_DEV_ADMIN_PREVIEW=false
STARFRONT_STORY_REVIEW_MODE=false

# External Integrations (Optional)
GITHUB_TOKEN=
GCS_STORY_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=
