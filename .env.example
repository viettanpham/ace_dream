# STARFRONT Environment Variables Template
# Public Preview and Core Runtime operate 100% out-of-the-box using the defaults below.

# Asset CDN & Storage Configuration (Built-in default is Universal CDN R3, zero configuration needed)
# NEXT_PUBLIC_ASSET_STORAGE_MODE=jsdelivr
# NEXT_PUBLIC_ASSET_CDN_URL=https://cdn.jsdelivr.net/gh/viettanpham/starfront-assets@v3.0-assets-r3/starfront-world-assets

# Optional Dedicated Mirror for Cloudflare R2 (leave commented to use default assets.starfrontworld.com)
# NEXT_PUBLIC_R2_ASSET_CDN_URL=

# Story Reader Development Review Mode (default false)
# STARFRONT_STORY_REVIEW_MODE=false

# Optional Server Secrets for Custom AdminCP Maintenance
# Note: When unset, the server automatically generates and maintains a secure random key in .starfront-config/session-secret.key
# ADMIN_SESSION_SECRET=
# STARFRONT_ADMIN_PRIMARY_PASSWORD=
# STARFRONT_ADMIN_BACKUP_PASSWORD=
# STARFRONT_ADMIN_THIRD_PASSWORD=
# STARFRONT_PREVIEW_SECRET_KEY=

# Optional Cloud Integrations (for automated GitHub push or Cloud Storage sync)
# GITHUB_TOKEN=
# GCS_STORY_BUCKET_NAME=
