# STARFRONT WORLD V2 — ENVIRONMENT TEMPLATE
# Do NOT store actual secrets or passwords in this file.

# Next.js Server Environment
NODE_ENV=development

# AdminCP Local Development Direct Access
# Set to 'true' in .env.local to enable password-free AdminCP access on local loopback (localhost)
STARFRONT_ALLOW_LOCAL_DEV_AUTH_BYPASS=true

# AdminCP Session & Authentication (Server-only secrets in production)
# ADMIN_SESSION_SECRET=
# STARFRONT_ADMIN_PRIMARY_PASSWORD=
# STARFRONT_ADMIN_BACKUP_PASSWORD=

# Google Cloud Storage (Production Content Bucket)
# GCS_STORY_BUCKET_NAME=
