# STARFRONT WORLD V2 — ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================================
# ZERO-CONFIG OUT OF THE BOX:
# Public Preview (Homepage, V1, V2 Pilots, Story Reader, CDN R3 Gallery)
# runs completely with NO environment variables required.
# =========================================================================

# --- 1. PUBLIC CDN ASSET DELIVERY (ZERO-CONFIG DEFAULTS) ---
# The application automatically uses these defaults in source code if omitted:
# - Mode: jsdelivr
# - CDN Base: https://cdn.jsdelivr.net/gh/viettanpham/starfront-assets@v3.0-assets-r3/starfront-world-assets
#
# (Keep commented out to prevent Google AI Studio from triggering the 'Set Environment Variables' modal)
# NEXT_PUBLIC_ASSET_STORAGE_MODE=jsdelivr
# NEXT_PUBLIC_ASSET_CDN_URL=https://cdn.jsdelivr.net/gh/viettanpham/starfront-assets@v3.0-assets-r3/starfront-world-assets

# --- 2. OPTIONAL ADVANCED OVERRIDES (Leave commented for Zero-Config) ---
# Only uncomment and configure these if you are self-hosting custom infrastructure.
#
# # Custom Cloudflare R2 / S3 Endpoint (if not using jsDelivr R3)
# NEXT_PUBLIC_R2_ASSET_CDN_URL=https://assets.starfrontworld.com/v3.0-assets-r3/starfront-world-assets
#
# # Custom Admin Session Secret (Auto-generated and persisted in .starfront-config if omitted)
# ADMIN_SESSION_SECRET=
#
# # Custom External Admin Passwords (Override internal secure bcrypt/scrypt hashes)
# STARFRONT_ADMIN_PRIMARY_PASSWORD=
# STARFRONT_ADMIN_BACKUP_PASSWORD=
#
# # External GCS Bucket for Story Backups (Optional)
# GCS_STORY_BUCKET_NAME=
# GOOGLE_APPLICATION_CREDENTIALS=
#
# # GitHub API Token for Asset Release Validation (Optional higher rate-limits)
# GITHUB_TOKEN=
