# STARFRONT Environment Variables Template

# Asset CDN & Storage Configuration
# Storage mode options: jsdelivr | cloudflare_r2 | custom | local (default: jsdelivr)
NEXT_PUBLIC_ASSET_STORAGE_MODE=jsdelivr
# Active CDN Base URL (R3 confirmed: https://cdn.jsdelivr.net/gh/viettanpham/starfront-assets@v3.0-assets-r3/starfront-world-assets/)
NEXT_PUBLIC_ASSET_CDN_URL=https://cdn.jsdelivr.net/gh/viettanpham/starfront-assets@v3.0-assets-r3/starfront-world-assets
# Optional dedicated Cloudflare R2 bucket mirror URL (leave blank to use default https://assets.starfrontworld.com)
NEXT_PUBLIC_R2_ASSET_CDN_URL=

# Admin Authentication & Session Secrets
ADMIN_SESSION_SECRET=
STARFRONT_ADMIN_PRIMARY_PASSWORD=
STARFRONT_ADMIN_BACKUP_PASSWORD=
STARFRONT_ADMIN_THIRD_PASSWORD=
STARFRONT_PREVIEW_SECRET_KEY=

# Story Reader Modes
STARFRONT_STORY_REVIEW_MODE=false

# Optional Integrations
GITHUB_TOKEN=
GCS_STORY_BUCKET_NAME=
